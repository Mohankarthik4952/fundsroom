{
  "info": {
    "name": "Mini ERP + CRM API",
    "description": "Postman collection for the Mini ERP CRM operations portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["health"]
        }
      }
    },
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@mini.erp\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "http://localhost:4000/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Customers List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "http://localhost:4000/customers",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["customers"]
        }
      }
    },
    {
      "name": "Products List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "http://localhost:4000/products",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["products"]
        }
      }
    },
    {
      "name": "Create Challan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"<customer_id>\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    {\n      \"productId\": \"<product_id>\",\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:4000/challans",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["challans"]
        }
      }
    }
  ],
  "variable": [{ "key": "token", "value": "" }]
}
